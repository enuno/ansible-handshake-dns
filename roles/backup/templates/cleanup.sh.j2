#!/bin/bash
# DNS Backup Cleanup Script
# Generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="{{ backup_dir }}"
RETENTION_DAYS={{ backup_retention_days }}

echo "[$(date)] Starting backup cleanup (retention: ${RETENTION_DAYS} days)..."

# Remove backups older than retention period
find "${BACKUP_DIR}" -name "dns-backup-*.tar.gz" -type f -mtime +${RETENTION_DAYS} -delete

# Count remaining backups
BACKUP_COUNT=$(find "${BACKUP_DIR}" -name "dns-backup-*.tar.gz" -type f | wc -l)
echo "[$(date)] Cleanup complete. ${BACKUP_COUNT} backups remaining."
