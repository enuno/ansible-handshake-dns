#!/bin/bash
# DNS Infrastructure Backup Script
# Generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="{{ backup_dir }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_NAME="dns-backup-${TIMESTAMP}"
BACKUP_PATH="${BACKUP_DIR}/${BACKUP_NAME}"

echo "[$(date)] Starting DNS infrastructure backup..."

# Create backup directory
mkdir -p "${BACKUP_PATH}"

{% if backup_hsd_wallet %}
# Backup HSD wallet
echo "[$(date)] Backing up HSD wallet..."
if docker exec hsd hsd-cli wallet backup --name="${BACKUP_NAME}" 2>/dev/null; then
    docker cp hsd:/root/.hsd/wallet "${BACKUP_PATH}/hsd-wallet"
    echo "[$(date)] HSD wallet backup completed"
else
    echo "[$(date)] Warning: HSD wallet backup failed"
fi
{% endif %}

{% if backup_configurations %}
# Backup configurations
echo "[$(date)] Backing up configurations..."
mkdir -p "${BACKUP_PATH}/configs"
cp -r /etc/unbound/unbound.conf.d/* "${BACKUP_PATH}/configs/" 2>/dev/null || true
cp -r /etc/caddy/* "${BACKUP_PATH}/configs/" 2>/dev/null || true
cp -r {{ hsd_data_dir }}/hip5.json "${BACKUP_PATH}/configs/" 2>/dev/null || true
echo "[$(date)] Configuration backup completed"
{% endif %}

{% if backup_certificates %}
# Backup certificates
echo "[$(date)] Backing up certificates..."
mkdir -p "${BACKUP_PATH}/certs"
cp -r /opt/certs/* "${BACKUP_PATH}/certs/" 2>/dev/null || true
echo "[$(date)] Certificate backup completed"
{% endif %}

# Save Docker container information
echo "[$(date)] Saving Docker container info..."
docker ps -a --format "{{.Names}}\t{{.Image}}\t{{.Status}}" > "${BACKUP_PATH}/containers.txt"
docker network ls --format "{{.Name}}\t{{.Driver}}\t{{.Scope}}" > "${BACKUP_PATH}/networks.txt"

{% if backup_compress %}
# Compress backup
echo "[$(date)] Compressing backup..."
cd "${BACKUP_DIR}"
tar -czf "${BACKUP_NAME}.tar.gz" "${BACKUP_NAME}"
rm -rf "${BACKUP_PATH}"
echo "[$(date)] Compression completed: ${BACKUP_NAME}.tar.gz"
{% endif %}

{% if backup_remote_enabled %}
# Upload to remote storage
echo "[$(date)] Uploading to remote storage..."
{% if backup_remote_type == 's3' %}
# S3 upload (requires aws-cli)
aws s3 cp "${BACKUP_DIR}/${BACKUP_NAME}.tar.gz" "{{ backup_remote_destination }}/" || echo "Remote upload failed"
{% elif backup_remote_type == 'rsync' %}
# Rsync upload
rsync -avz "${BACKUP_DIR}/${BACKUP_NAME}.tar.gz" "{{ backup_remote_destination }}/" || echo "Remote upload failed"
{% endif %}
echo "[$(date)] Remote upload completed"
{% endif %}

echo "[$(date)] Backup completed successfully!"
